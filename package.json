{
  "private": true,
  "name": "keet-lite",
  "description": "A one-screen Expo chat that runs a Hyperswarm core in a Bare worklet",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "postinstall": "node scripts/link.js",
    "bundle:worklet": "node scripts/pack.js",
    "lint": "standard src worklet scripts plugins",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsynKarma/keet-lite.git"
  },
  "author": "Venugopal Reddy Devarapally",
  "license": "Apache-2.0",
  "imports": {
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "os": {
      "bare": "bare-os",
      "default": "os"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    }
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "@shopify/flash-list": "^2.0.0",
    "b4a": "^1.6.7",
    "bare-events": "^2.2.0",
    "bare-os": "^3.0.0",
    "bare-path": "^3.0.0",
    "bare-rpc": "^2.0.0",
    "compact-encoding": "^3.4.0",
    "expo": "~55.0.23",
    "expo-build-properties": "~55.0.9",
    "expo-constants": "~55.0.7",
    "expo-file-system": "~55.0.0",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-system-ui": "~55.0.17",
    "keet-lite-core": "github:AsynKarma/keet-lite-core",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-b4a": "^0.0.4",
    "react-native-bare-kit": "0.15.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "redux-saga": "^1.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.25",
    "bare-link": "^4.4.0",
    "bare-pack": "^3.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prettier-config-holepunch": "^2.0.0",
    "standard": "^17.1.2",
    "typescript": "^5.3.3"
  },
  "standard": {
    "env": [
      "jest"
    ],
    "ignore": [
      "worklet/packed.js",
      "bare-addons/**"
    ]
  }
}
